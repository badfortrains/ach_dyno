rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validSample(sample, runDuration) {
      return sample is map && sample.keys().hasOnly(['t', 'f']) &&
        sample.t is number && sample.t >= 0 && sample.t <= runDuration &&
        sample.f is number && sample.f >= -10000000 && sample.f <= 10000000;
    }
    function validRun(d) {
      return d.keys().hasAll(['timestamp', 'leg', 'exercise', 'durationMs', 'sampleRateHz',
          'peakForceN', 'samples', 'source', 'stopReason', 'schemaVersion']) &&
        d.keys().hasOnly(['timestamp', 'leg', 'exercise', 'durationMs', 'sampleRateHz',
          'peakForceN', 'samples', 'source', 'stopReason', 'schemaVersion']) &&
        d.schemaVersion == 1 && d.timestamp is string &&
        d.timestamp.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$') &&
        d.leg in ['left', 'right'] && d.exercise is string && d.exercise.size() > 0 && d.exercise.size() <= 80 &&
        d.durationMs is number && d.durationMs >= 0 && d.durationMs <= 300000 &&
        d.sampleRateHz is number && d.sampleRateHz >= 0 && d.sampleRateHz <= 1000 &&
        d.peakForceN is number && d.peakForceN >= 0 && d.peakForceN <= 10000000 &&
        d.source == 'device' && d.stopReason is string && d.stopReason.size() <= 200 &&
        d.samples is list && d.samples.size() > 0 && d.samples.size() <= 6000 &&
        validSample(d.samples[0], d.durationMs) && validSample(d.samples[d.samples.size() - 1], d.durationMs);
    }
    match /users/{uid}/runs/{runId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validRun(request.resource.data);
      // Stable UUID retries succeed; completed runs are immutable in V1.
      allow update: if owner(uid) && request.resource.data == resource.data;
      allow delete: if owner(uid);
    }
  }
}
